# ===== Supabase =====
# Project URL: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
# anon (public, safe for browser) key: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key (server-only, NEVER expose to browser): Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===== PostgreSQL (Supabase) via Prisma =====
# DATABASE_URL uses the transaction/connection-pooler endpoint (port 6543, PgBouncer).
# From Supabase Dashboard > Settings > Database > Connection string (transaction / pooler).
DATABASE_URL="postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL bypasses the pooler (direct, port 5432) — used by Prisma migrations.
# From Supabase Dashboard > Settings > Database > Connection string (direct, port 5432).
DIRECT_URL="postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ===== Sanity =====
# Project ID & dataset: Sanity manage (sanity.io/manage) > your project > Settings
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# API token for reading/writing content from server code:
# Sanity manage > Project > API > Tokens > Add API token
SANITY_API_TOKEN="sk-your-sanity-api-token"
